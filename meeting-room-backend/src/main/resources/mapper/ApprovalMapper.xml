<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.meetingroom.mapper.ApprovalMapper">
    <resultMap id="ApprovalResultMap" type="com.meetingroom.entity.Approval">
        <id property="approvalId" column="approval_id"/>
        <result property="approvalResult" column="approval_result"/>
        <result property="rejectReason" column="reject_reason"/>
        <result property="createdAt" column="created_at"/>
        <association property="reservation" javaType="com.meetingroom.entity.Reservation">
            <id property="reservationId" column="reservation_id"/>
        </association>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="approvalId" keyColumn="approval_id">
        INSERT INTO approval (reservation_id, approval_result, reject_reason)
        VALUES (#{reservation.reservationId}, #{approvalResult}, #{rejectReason})
    </insert>

    <select id="findByReservationId" resultMap="ApprovalResultMap">
        SELECT approval_id, reservation_id, approval_result, reject_reason, created_at
        FROM approval
        WHERE reservation_id = #{reservationId}
    </select>
</mapper>
